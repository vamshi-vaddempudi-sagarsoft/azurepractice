{
  "name": "pl_MetaDriven_ProcessEntity",
  "type": "Microsoft.DataFactory/factories/pipelines",
  "properties": {
  "activities": [
    {
      "name": "GetEntityConfig",
      "type": "Lookup",
      "typeProperties": {
        "source": {
          "type": "AzureSqlSource",
          "sqlReaderQuery": {
            "value": "SELECT e.EntityId, e.EntityName, e.EntityType, e.SCDType, e.StagingTable, e.TargetTable, e.BusinessKeyColumns, e.SourceContainer, e.SourcePathPattern, e.SourceFileName, e.ChunkSize, (SELECT STRING_AGG(TargetColumn, ',') FROM meta.ColumnMapping cm WHERE cm.EntityId = e.EntityId AND cm.IsBusinessKey = 0) AS AttributeColumns, CASE WHEN e.EntityType='Fact' THEN 'Fact' WHEN e.SCDType=2 THEN 'SCD2' ELSE 'SCD1Generic' END AS LoadPath FROM meta.EntityConfig e WHERE e.EntityId = @{pipeline().parameters.EntityId}",
            "type": "Expression"
          }
        },
        "dataset": {
          "referenceName": "DS_ControlDB_Table",
          "type": "DatasetReference",
          "parameters": { "schemaName": "meta", "tableName": "EntityConfig" }
        },
        "firstRowOnly": true
      }
    },
    {
      "name": "LogRunStart",
      "type": "SqlServerStoredProcedure",
      "dependsOn": [ { "activity": "GetEntityConfig", "dependencyConditions": [ "Succeeded" ] } ],
      "linkedServiceName": { "referenceName": "LS_ControlDB", "type": "LinkedServiceReference" },
      "typeProperties": {
        "storedProcedureName": "meta.usp_LogRunStart",
        "storedProcedureParameters": {
          "PipelineName": { "value": "pl_MetaDriven_ProcessEntity", "type": "String" },
          "ADFRunId": { "value": "@pipeline().RunId", "type": "String" },
          "EntityId": { "value": "@pipeline().parameters.EntityId", "type": "Int32" }
        }
      }
    },
    {
      "name": "ClearStaging",
      "type": "SqlServerStoredProcedure",
      "dependsOn": [ { "activity": "LogRunStart", "dependencyConditions": [ "Succeeded" ] } ],
      "linkedServiceName": { "referenceName": "LS_ControlDB", "type": "LinkedServiceReference" },
      "typeProperties": {
        "storedProcedureName": "meta.usp_TruncateControlTable",
        "storedProcedureParameters": {
          "TableName": { "value": "@activity('GetEntityConfig').output.firstRow.StagingTable", "type": "String" }
        }
      }
    },
    {
      "name": "LandToStaging",
      "type": "Copy",
      "dependsOn": [ { "activity": "ClearStaging", "dependencyConditions": [ "Succeeded" ] } ],
      "policy": { "timeout": "0.00:30:00", "retry": 0, "retryIntervalInSeconds": 30, "secureOutput": false, "secureInput": false },
      "typeProperties": {
        "source": { "type": "DelimitedTextSource" },
        "sink": { "type": "AzureSqlSink" },
        "enableStaging": false
      },
      "inputs": [
        {
          "referenceName": "DS_ADLS_CSV",
          "type": "DatasetReference",
          "parameters": {
            "container": { "value": "@activity('GetEntityConfig').output.firstRow.SourceContainer", "type": "Expression" },
            "folderPath": { "value": "@activity('GetEntityConfig').output.firstRow.SourcePathPattern", "type": "Expression" },
            "fileName": { "value": "@activity('GetEntityConfig').output.firstRow.SourceFileName", "type": "Expression" }
          }
        }
      ],
      "outputs": [
        {
          "referenceName": "DS_ControlDB_Table",
          "type": "DatasetReference",
          "parameters": {
            "schemaName": { "value": "@split(activity('GetEntityConfig').output.firstRow.StagingTable, '.')[0]", "type": "Expression" },
            "tableName": { "value": "@split(activity('GetEntityConfig').output.firstRow.StagingTable, '.')[1]", "type": "Expression" }
          }
        }
      ]
    },
    {
      "name": "DeadLetterCopy",
      "type": "Copy",
      "dependsOn": [ { "activity": "LandToStaging", "dependencyConditions": [ "Failed" ] } ],
      "typeProperties": {
        "source": { "type": "DelimitedTextSource" },
        "sink": { "type": "DelimitedTextSink" }
      },
      "inputs": [
        {
          "referenceName": "DS_ADLS_CSV",
          "type": "DatasetReference",
          "parameters": {
            "container": { "value": "@activity('GetEntityConfig').output.firstRow.SourceContainer", "type": "Expression" },
            "folderPath": { "value": "@activity('GetEntityConfig').output.firstRow.SourcePathPattern", "type": "Expression" },
            "fileName": { "value": "@activity('GetEntityConfig').output.firstRow.SourceFileName", "type": "Expression" }
          }
        }
      ],
      "outputs": [
        {
          "referenceName": "DS_ADLS_CSV",
          "type": "DatasetReference",
          "parameters": {
            "container": { "value": "@activity('GetEntityConfig').output.firstRow.SourceContainer", "type": "Expression" },
            "folderPath": { "value": "@concat('_quarantine/', activity('GetEntityConfig').output.firstRow.EntityName, '/', formatDateTime(utcnow(), 'yyyyMMddHHmmss'), '/')", "type": "Expression" },
            "fileName": { "value": "@activity('GetEntityConfig').output.firstRow.SourceFileName", "type": "Expression" }
          }
        }
      ]
    },
    {
      "name": "LogFileLanded",
      "type": "SqlServerStoredProcedure",
      "dependsOn": [ { "activity": "LandToStaging", "dependencyConditions": [ "Succeeded" ] } ],
      "linkedServiceName": { "referenceName": "LS_ControlDB", "type": "LinkedServiceReference" },
      "typeProperties": {
        "storedProcedureName": "meta.usp_LogFile",
        "storedProcedureParameters": {
          "EntityId": { "value": "@pipeline().parameters.EntityId", "type": "Int32" },
          "FilePath": { "value": "@concat(activity('GetEntityConfig').output.firstRow.SourceContainer, '/', activity('GetEntityConfig').output.firstRow.SourcePathPattern)", "type": "String" },
          "FileName": { "value": "@activity('GetEntityConfig').output.firstRow.SourceFileName", "type": "String" },
          "FileRowCount": { "value": "@activity('LandToStaging').output.rowsCopied", "type": "Int64" },
          "ValidationStatus": { "value": "Landed", "type": "String" }
        }
      }
    },
    {
      "name": "ValidateChunks",
      "type": "ForEach",
      "dependsOn": [ { "activity": "LandToStaging", "dependencyConditions": [ "Succeeded" ] } ],
      "typeProperties": {
        "items": {
          "value": "@range(0, div(add(activity('LandToStaging').output.rowsCopied, sub(activity('GetEntityConfig').output.firstRow.ChunkSize, 1)), activity('GetEntityConfig').output.firstRow.ChunkSize))",
          "type": "Expression"
        },
        "isSequential": false,
        "batchCount": 4,
        "activities": [
          {
            "name": "ValidateChunk",
            "type": "SqlServerStoredProcedure",
            "policy": { "timeout": "0.00:30:00", "retry": 1, "retryIntervalInSeconds": 30, "secureOutput": false, "secureInput": false },
            "linkedServiceName": { "referenceName": "LS_ControlDB", "type": "LinkedServiceReference" },
            "typeProperties": {
              "storedProcedureName": "meta.usp_ValidateEntity",
              "storedProcedureParameters": {
                "EntityId": { "value": "@pipeline().parameters.EntityId", "type": "Int32" },
                "BatchId": { "value": "@pipeline().RunId", "type": "String" },
                "StartRowId": {
                  "value": "@add(mul(item(), activity('GetEntityConfig').output.firstRow.ChunkSize), 1)",
                  "type": "Int64"
                },
                "EndRowId": {
                  "value": "@min(mul(add(item(), 1), activity('GetEntityConfig').output.firstRow.ChunkSize), activity('LandToStaging').output.rowsCopied)",
                  "type": "Int64"
                }
              }
            }
          }
        ]
      }
    },
    {
      "name": "Dedupe",
      "type": "SqlServerStoredProcedure",
      "dependsOn": [ { "activity": "ValidateChunks", "dependencyConditions": [ "Succeeded" ] } ],
      "policy": { "timeout": "0.00:30:00", "retry": 1, "retryIntervalInSeconds": 30, "secureOutput": false, "secureInput": false },
      "linkedServiceName": { "referenceName": "LS_ControlDB", "type": "LinkedServiceReference" },
      "typeProperties": {
        "storedProcedureName": "meta.usp_DeduplicateEntity",
        "storedProcedureParameters": {
          "EntityId": { "value": "@pipeline().parameters.EntityId", "type": "Int32" },
          "BatchId": { "value": "@pipeline().RunId", "type": "String" }
        }
      }
    },
    {
      "name": "GetRejectedCount",
      "type": "Lookup",
      "dependsOn": [ { "activity": "Dedupe", "dependencyConditions": [ "Succeeded" ] } ],
      "typeProperties": {
        "source": {
          "type": "AzureSqlSource",
          "sqlReaderQuery": {
            "value": "@concat('SELECT (SELECT COUNT(*) FROM stg.ErrorRows WHERE EntityName=''', activity('GetEntityConfig').output.firstRow.EntityName, ''' AND BatchId=''', pipeline().RunId, ''') + (SELECT COUNT(*) FROM stg.DuplicateLog WHERE EntityName=''', activity('GetEntityConfig').output.firstRow.EntityName, ''' AND BatchId=''', pipeline().RunId, ''') AS RejectedCount')",
            "type": "Expression"
          }
        },
        "dataset": {
          "referenceName": "DS_ControlDB_Table",
          "type": "DatasetReference",
          "parameters": { "schemaName": "stg", "tableName": "ErrorRows" }
        },
        "firstRowOnly": true
      }
    },
    {
      "name": "ClearSynapseLanding",
      "type": "SqlServerStoredProcedure",
      "dependsOn": [ { "activity": "Dedupe", "dependencyConditions": [ "Succeeded" ] } ],
      "linkedServiceName": { "referenceName": "LS_Synapse", "type": "LinkedServiceReference" },
      "typeProperties": {
        "storedProcedureName": "dw.usp_TruncateTable",
        "storedProcedureParameters": {
          "TableName": { "value": "@concat('stg.', activity('GetEntityConfig').output.firstRow.EntityName)", "type": "String" }
        }
      }
    },
    {
      "name": "LandCleanToSynapse",
      "type": "Copy",
      "dependsOn": [ { "activity": "ClearSynapseLanding", "dependencyConditions": [ "Succeeded" ] } ],
      "policy": { "timeout": "0.00:30:00", "retry": 0, "retryIntervalInSeconds": 30, "secureOutput": false, "secureInput": false },
      "typeProperties": {
        "source": {
          "type": "AzureSqlSource",
          "sqlReaderQuery": {
            "value": "@concat('SELECT ', activity('GetEntityConfig').output.firstRow.BusinessKeyColumns, ', ', activity('GetEntityConfig').output.firstRow.AttributeColumns, ' FROM ', activity('GetEntityConfig').output.firstRow.StagingTable, ' s WHERE s.StagingRowId NOT IN (SELECT SourceRowId FROM stg.ErrorRows WHERE EntityName=''', activity('GetEntityConfig').output.firstRow.EntityName, ''' AND SourceRowId IS NOT NULL)')",
            "type": "Expression"
          }
        },
        "sink": {
          "type": "AzureSqlDWSink",
          "allowCopyCommand": false
        }
      },
      "inputs": [
        {
          "referenceName": "DS_ControlDB_Table",
          "type": "DatasetReference",
          "parameters": {
            "schemaName": { "value": "@split(activity('GetEntityConfig').output.firstRow.StagingTable, '.')[0]", "type": "Expression" },
            "tableName": { "value": "@split(activity('GetEntityConfig').output.firstRow.StagingTable, '.')[1]", "type": "Expression" }
          }
        }
      ],
      "outputs": [
        {
          "referenceName": "DS_Synapse_Table",
          "type": "DatasetReference",
          "parameters": {
            "schemaName": "stg",
            "tableName": { "value": "@activity('GetEntityConfig').output.firstRow.EntityName", "type": "Expression" }
          }
        }
      ]
    },
    {
      "name": "LoadWarehouse",
      "type": "Switch",
      "dependsOn": [ { "activity": "LandCleanToSynapse", "dependencyConditions": [ "Succeeded" ] } ],
      "typeProperties": {
        "on": { "value": "@activity('GetEntityConfig').output.firstRow.LoadPath", "type": "Expression" },
        "cases": [
          {
            "value": "Fact",
            "activities": [
              {
                "name": "GetWatermark",
                "type": "Lookup",
                "typeProperties": {
                  "source": {
                    "type": "AzureSqlSource",
                    "sqlReaderQuery": "SELECT LastWatermarkValue FROM meta.Watermark WHERE EntityName = 'SalesOrder'"
                  },
                  "dataset": {
                    "referenceName": "DS_ControlDB_Table",
                    "type": "DatasetReference",
                    "parameters": { "schemaName": "meta", "tableName": "Watermark" }
                  },
                  "firstRowOnly": true
                }
              },
              {
                "name": "LoadFact",
                "type": "SqlServerStoredProcedure",
                "dependsOn": [ { "activity": "GetWatermark", "dependencyConditions": [ "Succeeded" ] } ],
                "linkedServiceName": { "referenceName": "LS_Synapse", "type": "LinkedServiceReference" },
                "typeProperties": {
                  "storedProcedureName": "dw.usp_LoadFactSales",
                  "storedProcedureParameters": {
                    "WatermarkDate": { "value": "@activity('GetWatermark').output.firstRow.LastWatermarkValue", "type": "String" }
                  }
                }
              },
              {
                "name": "GetNewWatermarkValue",
                "type": "Lookup",
                "dependsOn": [ { "activity": "LoadFact", "dependencyConditions": [ "Succeeded" ] } ],
                "typeProperties": {
                  "source": {
                    "type": "AzureSqlSource",
                    "sqlReaderQuery": "SELECT CONVERT(VARCHAR(10), MAX(OrderDate), 23) AS MaxDate FROM stg.SalesOrder"
                  },
                  "dataset": {
                    "referenceName": "DS_ControlDB_Table",
                    "type": "DatasetReference",
                    "parameters": { "schemaName": "stg", "tableName": "SalesOrder" }
                  },
                  "firstRowOnly": true
                }
              },
              {
                "name": "UpdateWatermark",
                "type": "SqlServerStoredProcedure",
                "dependsOn": [ { "activity": "GetNewWatermarkValue", "dependencyConditions": [ "Succeeded" ] } ],
                "linkedServiceName": { "referenceName": "LS_ControlDB", "type": "LinkedServiceReference" },
                "typeProperties": {
                  "storedProcedureName": "meta.usp_UpdateWatermark",
                  "storedProcedureParameters": {
                    "EntityName": { "value": "SalesOrder", "type": "String" },
                    "NewWatermarkValue": { "value": "@activity('GetNewWatermarkValue').output.firstRow.MaxDate", "type": "String" }
                  }
                }
              }
            ]
          },
          {
            "value": "SCD2",
            "activities": [
              {
                "name": "LoadDimCustomer",
                "type": "SqlServerStoredProcedure",
                "linkedServiceName": { "referenceName": "LS_Synapse", "type": "LinkedServiceReference" },
                "typeProperties": { "storedProcedureName": "dw.usp_LoadDimCustomer" }
              }
            ]
          }
        ],
        "defaultActivities": [
          {
            "name": "LoadDimGeneric",
            "type": "SqlServerStoredProcedure",
            "linkedServiceName": { "referenceName": "LS_Synapse", "type": "LinkedServiceReference" },
            "typeProperties": {
              "storedProcedureName": "dw.usp_LoadDimGeneric",
              "storedProcedureParameters": {
                "StagingTable": { "value": "@activity('GetEntityConfig').output.firstRow.StagingTable", "type": "String" },
                "TargetTable": { "value": "@activity('GetEntityConfig').output.firstRow.TargetTable", "type": "String" },
                "BusinessKeyCol": { "value": "@activity('GetEntityConfig').output.firstRow.BusinessKeyColumns", "type": "String" },
                "AttributeCols": { "value": "@activity('GetEntityConfig').output.firstRow.AttributeColumns", "type": "String" }
              }
            }
          }
        ]
      }
    },
    {
      "name": "LogRunSuccess",
      "type": "SqlServerStoredProcedure",
      "dependsOn": [
        { "activity": "LoadWarehouse", "dependencyConditions": [ "Succeeded" ] },
        { "activity": "GetRejectedCount", "dependencyConditions": [ "Succeeded" ] }
      ],
      "linkedServiceName": { "referenceName": "LS_ControlDB", "type": "LinkedServiceReference" },
      "typeProperties": {
        "storedProcedureName": "meta.usp_LogRunComplete",
        "storedProcedureParameters": {
          "ADFRunId": { "value": "@pipeline().RunId", "type": "String" },
          "EntityId": { "value": "@pipeline().parameters.EntityId", "type": "Int32" },
          "Status": { "value": "Success", "type": "String" },
          "RowsRead": { "value": "@activity('LandToStaging').output.rowsCopied", "type": "Int64" },
          "RowsInserted": { "value": "@activity('LandCleanToSynapse').output.rowsCopied", "type": "Int64" },
          "RowsRejected": { "value": "@activity('GetRejectedCount').output.firstRow.RejectedCount", "type": "Int64" }
        }
      }
    },
    {
      "name": "LogRunFailure",
      "type": "SqlServerStoredProcedure",
      "dependsOn": [ { "activity": "LoadWarehouse", "dependencyConditions": [ "Failed", "Skipped" ] } ],
      "linkedServiceName": { "referenceName": "LS_ControlDB", "type": "LinkedServiceReference" },
      "typeProperties": {
        "storedProcedureName": "meta.usp_LogRunComplete",
        "storedProcedureParameters": {
          "ADFRunId": { "value": "@pipeline().RunId", "type": "String" },
          "EntityId": { "value": "@pipeline().parameters.EntityId", "type": "Int32" },
          "Status": { "value": "Failed", "type": "String" },
          "ErrorMessage": { "value": "@concat('Run failed for EntityId=', string(pipeline().parameters.EntityId), '. Check ADF Monitor, RunId=', pipeline().RunId, ' for the exact activity and error.')", "type": "String" }
        }
      }
    }
  ],
  "parameters": {
    "EntityId": { "type": "int" }
  }
}
}