{
  "name": "pl_MetaDriven_ProcessEntity",
  "type": "Microsoft.DataFactory/factories/pipelines",
  "properties": {
  "activities": [
    {
      "name": "GetEntityConfig",
      "type": "Lookup",
      "typeProperties": {
        "source": {
          "type": "AzureSqlSource",
          "sqlReaderQuery": {
            "value": "SELECT e.EntityId, e.EntityName, e.EntityType, e.SCDType, e.StagingTable, e.TargetTable, e.BusinessKeyColumns, e.SourceContainer, e.SourcePathPattern, e.SourceFileName, (SELECT STRING_AGG(TargetColumn, ',') FROM meta.ColumnMapping cm WHERE cm.EntityId = e.EntityId AND cm.IsBusinessKey = 0) AS AttributeColumns, CASE WHEN e.EntityType='Fact' THEN 'Fact' WHEN e.SCDType=2 THEN 'SCD2' ELSE 'SCD1Generic' END AS LoadPath FROM meta.EntityConfig e WHERE e.EntityId = @{pipeline().parameters.EntityId}",
            "type": "Expression"
          }
        },
        "dataset": {
          "referenceName": "DS_ControlDB_Table",
          "type": "DatasetReference",
          "parameters": { "schemaName": "meta", "tableName": "EntityConfig" }
        },
        "firstRowOnly": true
      }
    },
    {
      "name": "LandToStaging",
      "type": "Copy",
      "dependsOn": [ { "activity": "GetEntityConfig", "dependencyConditions": [ "Succeeded" ] } ],
      "typeProperties": {
        "source": {
          "type": "DelimitedTextSource"
        },
        "sink": {
          "type": "AzureSqlSink",
          "preCopyScript": {
            "value": "@concat('DELETE FROM ', activity('GetEntityConfig').output.firstRow.StagingTable)",
            "type": "Expression"
          }
        },
        "enableStaging": false
      },
      "inputs": [
        {
          "referenceName": "DS_ADLS_CSV",
          "type": "DatasetReference",
          "parameters": {
            "container": { "value": "@activity('GetEntityConfig').output.firstRow.SourceContainer", "type": "Expression" },
            "folderPath": { "value": "@activity('GetEntityConfig').output.firstRow.SourcePathPattern", "type": "Expression" },
            "fileName": { "value": "@activity('GetEntityConfig').output.firstRow.SourceFileName", "type": "Expression" }
          }
        }
      ],
      "outputs": [
        {
          "referenceName": "DS_ControlDB_Table",
          "type": "DatasetReference",
          "parameters": {
            "schemaName": { "value": "@split(activity('GetEntityConfig').output.firstRow.StagingTable, '.')[0]", "type": "Expression" },
            "tableName": { "value": "@split(activity('GetEntityConfig').output.firstRow.StagingTable, '.')[1]", "type": "Expression" }
          }
        }
      ]
    },
    {
      "name": "Validate",
      "type": "SqlServerStoredProcedure",
      "dependsOn": [ { "activity": "LandToStaging", "dependencyConditions": [ "Succeeded" ] } ],
      "linkedServiceName": { "referenceName": "LS_ControlDB", "type": "LinkedServiceReference" },
      "typeProperties": {
        "storedProcedureName": "meta.usp_ValidateEntity",
        "storedProcedureParameters": {
          "EntityId": { "value": "@pipeline().parameters.EntityId", "type": "Int32" },
          "BatchId": { "value": "@pipeline().RunId", "type": "String" }
        }
      }
    },
    {
      "name": "Dedupe",
      "type": "SqlServerStoredProcedure",
      "dependsOn": [ { "activity": "Validate", "dependencyConditions": [ "Succeeded" ] } ],
      "linkedServiceName": { "referenceName": "LS_ControlDB", "type": "LinkedServiceReference" },
      "typeProperties": {
        "storedProcedureName": "meta.usp_DeduplicateEntity",
        "storedProcedureParameters": {
          "EntityId": { "value": "@pipeline().parameters.EntityId", "type": "Int32" },
          "BatchId": { "value": "@pipeline().RunId", "type": "String" }
        }
      }
    },
    {
      "name": "ClearSynapseLanding",
      "type": "SqlServerStoredProcedure",
      "dependsOn": [ { "activity": "Dedupe", "dependencyConditions": [ "Succeeded" ] } ],
      "linkedServiceName": { "referenceName": "LS_Synapse", "type": "LinkedServiceReference" },
      "typeProperties": {
        "storedProcedureName": "dw.usp_TruncateTable",
        "storedProcedureParameters": {
          "TableName": { "value": "@concat('stg.', activity('GetEntityConfig').output.firstRow.EntityName)", "type": "String" }
        }
      }
    },
    {
      "name": "LandCleanToSynapse",
      "type": "Copy",
      "dependsOn": [ { "activity": "ClearSynapseLanding", "dependencyConditions": [ "Succeeded" ] } ],
      "typeProperties": {
        "source": {
          "type": "AzureSqlSource",
          "sqlReaderQuery": {
            "value": "@concat('SELECT ', activity('GetEntityConfig').output.firstRow.BusinessKeyColumns, ', ', activity('GetEntityConfig').output.firstRow.AttributeColumns, ' FROM ', activity('GetEntityConfig').output.firstRow.StagingTable, ' s WHERE s.StagingRowId NOT IN (SELECT SourceRowId FROM stg.ErrorRows WHERE EntityName=''', activity('GetEntityConfig').output.firstRow.EntityName, ''' AND SourceRowId IS NOT NULL)')",
            "type": "Expression"
          }
        },
        "sink": {
          "type": "AzureSqlDWSink",
          "allowCopyCommand": false
        }
      },
      "inputs": [
        {
          "referenceName": "DS_ControlDB_Table",
          "type": "DatasetReference",
          "parameters": {
            "schemaName": { "value": "@split(activity('GetEntityConfig').output.firstRow.StagingTable, '.')[0]", "type": "Expression" },
            "tableName": { "value": "@split(activity('GetEntityConfig').output.firstRow.StagingTable, '.')[1]", "type": "Expression" }
          }
        }
      ],
      "outputs": [
        {
          "referenceName": "DS_Synapse_Table",
          "type": "DatasetReference",
          "parameters": {
            "schemaName": "stg",
            "tableName": { "value": "@activity('GetEntityConfig').output.firstRow.EntityName", "type": "Expression" }
          }
        }
      ]
    },
    {
      "name": "LoadWarehouse",
      "type": "Switch",
      "dependsOn": [ { "activity": "LandCleanToSynapse", "dependencyConditions": [ "Succeeded" ] } ],
      "typeProperties": {
        "on": { "value": "@activity('GetEntityConfig').output.firstRow.LoadPath", "type": "Expression" },
        "cases": [
          {
            "value": "Fact",
            "activities": [
              {
                "name": "LoadFact",
                "type": "SqlServerStoredProcedure",
                "linkedServiceName": { "referenceName": "LS_Synapse", "type": "LinkedServiceReference" },
                "typeProperties": { "storedProcedureName": "dw.usp_LoadFactSales" }
              }
            ]
          },
          {
            "value": "SCD2",
            "activities": [
              {
                "name": "LoadDimCustomer",
                "type": "SqlServerStoredProcedure",
                "linkedServiceName": { "referenceName": "LS_Synapse", "type": "LinkedServiceReference" },
                "typeProperties": { "storedProcedureName": "dw.usp_LoadDimCustomer" }
              }
            ]
          }
        ],
        "defaultActivities": [
          {
            "name": "LoadDimGeneric",
            "type": "SqlServerStoredProcedure",
            "linkedServiceName": { "referenceName": "LS_Synapse", "type": "LinkedServiceReference" },
            "typeProperties": {
              "storedProcedureName": "dw.usp_LoadDimGeneric",
              "storedProcedureParameters": {
                "StagingTable": { "value": "@activity('GetEntityConfig').output.firstRow.StagingTable", "type": "String" },
                "TargetTable": { "value": "@activity('GetEntityConfig').output.firstRow.TargetTable", "type": "String" },
                "BusinessKeyCol": { "value": "@activity('GetEntityConfig').output.firstRow.BusinessKeyColumns", "type": "String" },
                "AttributeCols": { "value": "@activity('GetEntityConfig').output.firstRow.AttributeColumns", "type": "String" }
              }
            }
          }
        ]
      }
    }
  ],
  "parameters": {
    "EntityId": { "type": "int" }
  }
}
}